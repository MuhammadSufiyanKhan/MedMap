{
  "name": "@medmap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -b tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "tsx src/jobs/export-openapi.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/jobs/migrate.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/jobs/seed-demo.ts",
    "import:interactions": "tsx --env-file-if-exists=../../.env src/jobs/import-interactions.ts",
    "eval:extractor": "tsx --env-file-if-exists=../../.env src/jobs/eval-extractor.ts",
    "check:dataset": "tsx --env-file-if-exists=../../.env src/jobs/check-dataset.ts",
    "check:rxnorm": "tsx src/jobs/check-rxnorm.ts",
    "e2e:serve": "tsx src/jobs/migrate.ts && tsx src/jobs/seed-demo.ts && tsx src/server.ts"
  },
  "dependencies": {
    "@medmap/shared": "0.1.0",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
