# MedMap environment. Copy to .env for local development. Never commit .env.
# Every variable here is documented in the README table (CI checks they match).

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB connection string. `docker compose up -d mongo` serves this one.
MONGODB_URI=mongodb://127.0.0.1:27017/medmap

# Secret for signing access tokens. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Browser origins allowed to call the API (comma-separated) and the public web URL.
WEB_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
# Secure cookies. Leave empty to default to true in production and false elsewhere.
COOKIE_SECURE=
# Number of reverse proxies in front of the API (0 locally, 1 on most hosts).
TRUST_PROXY=0

# Safety guard: production refuses to start on the demo dataset unless this is true.
ALLOW_DEMO_DATA=true
# Serve Swagger UI at /api/docs. Leave empty to default to on outside production.
API_DOCS_ENABLED=

RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_EXTRACTION_MAX=10

# RxNorm name lookup (public NLM service, no key).
RXNORM_ENABLED=true
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Label photo reading. Off by default: manual entry only.
LABEL_EXTRACTION_ENABLED=false
# mock | ollama | anthropic
LABEL_EXTRACTOR=mock
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
EXTRACTION_TIMEOUT_MS=20000
EXTRACTION_DAILY_CAP=20

# console prints emails to the terminal. smtp needs SMTP_URL.
EMAIL_ADAPTER=console
EMAIL_FROM=MedMap <no-reply@localhost>
SMTP_URL=

# Optional error reporting. Leave empty to disable.
SENTRY_DSN=

# Web dev server only: where Vite proxies /api to.
VITE_DEV_API_PROXY=http://localhost:4000
